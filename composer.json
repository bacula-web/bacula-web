{
  "name": "bacula-web/bacula-web",
  "type": "project",
  "description": "The open source web based reporting and monitoring tool for Bacula",
  "keywords": [
    "php",
    "reporting",
    "monitoring",
    "bacula"
  ],
  "homepage": "https://www.bacula-web.org",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Juan Luis Francés Jimenez",
      "role": "Developer"
    },
    {
      "name": "Davide Franco",
      "email": "hello@bacula-web.org",
      "homepage": "https://www.bacula-web.org",
      "role": "Developer"
    },
    {
      "name": "Bacula-Web contributors",
      "homepage": "https://github.com/bacula-web/bacula-web/graphs/contributors"
    }
  ],
  "support": {
    "email": "hello@bacula-web.org",
    "issues": "https://github.com/bacula-web/bacula-web/issues",
    "forum": "https://github.com/bacula-web/bacula-web/discussions",
    "docs": "https://www.bacula-web.org/docs"
  },
  "funding": [
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/dfranco"
    }
  ],
  "config": {
    "component-dir": "vendor/components",
    "allow-plugins": {
      "composer/installers": true,
      "robloach/component-installer": true,
      "oomphinc/composer-installers-extender": true,
      "phpstan/extension-installer": true,
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "require": {
    "php": ">=8.1",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-sqlite3": "*",
    "novus/nvd3": "~1.8",
    "components/font-awesome": "6.*",
    "twbs/bootstrap": "~5.2.3",
    "symfony/translation": "^6.4",
    "symfony/console": "^6.4",
    "nesbot/carbon": "^2",
    "doctrine/orm": "^3.6",
    "doctrine/dbal": "^3.0",
    "symfony/cache": "^6.4",
    "symfony/framework-bundle": "^6.4",
    "symfony/http-kernel": "^6.4",
    "symfony/flex": "^2",
    "symfony/runtime": "^6.4",
    "symfony/twig-bridge": "^6.4",
    "symfony/twig-bundle": "^6.4",
    "doctrine/doctrine-bundle": "^2",
    "doctrine/doctrine-migrations-bundle": "^3.0",
    "twig/extra-bundle": "*",
    "symfony/monolog-bundle": "*",
    "symfony/debug-bundle": "*",
    "symfony/yaml": "^6.4",
    "symfony/dotenv": "^6.4",
    "symfony/form": "^6.4",
    "symfony/validator": "^6.4",
    "twig/intl-extra": "^3.24",
    "symfony/property-info": "^6.4",
    "knplabs/knp-paginator-bundle": "^6.10"
  },
  "require-dev": {
    "phpmd/phpmd": "@stable",
    "squizlabs/php_codesniffer": "@stable",
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^2.0",
    "symfony/var-dumper": "^6.4",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-doctrine": "^2.0",
    "symfony/stopwatch": "^6.4",
    "symfony/web-profiler-bundle": "^6.4",
    "symfony/maker-bundle": "^1.67"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "core/",
      "App\\": "application/"
    },
    "files": [
      "core/Helpers/request.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "archive": {
    "exclude": [
      ".gitignore",
      ".phpcs.xml",
      "sonar-project.properties",
      ".github",
      ".tx",
      "phpunit.xml",
      "/tests",
      ".release-please-manifest.json",
      "release-please-config.json",
      "cog.toml",
      "output.log",
      "DOCKER_ENV",
      "docker_tag",
      "website"
    ]
  }
}
