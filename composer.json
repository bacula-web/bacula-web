{
  "name": "bacula-web/bacula-web",
  "type": "project",
  "description": "The open source web based reporting and monitoring tool for Bacula",
  "keywords": [
    "php",
    "reporting",
    "monitoring",
    "bacula"
  ],
  "homepage": "https://www.bacula-web.org",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Juan Luis Francés Jimenez",
      "role": "Developer"
    },
    {
      "name": "Davide Franco",
      "email": "hello@bacula-web.org",
      "homepage": "https://www.bacula-web.org",
      "role": "Developer"
    },
    {
      "name": "Bacula-Web contributors",
      "homepage": "https://github.com/bacula-web/bacula-web/graphs/contributors"
    }
  ],
  "support": {
    "email": "hello@bacula-web.org",
    "issues": "https://github.com/bacula-web/bacula-web/issues",
    "forum": "https://github.com/bacula-web/bacula-web/discussions",
    "docs": "https://www.bacula-web.org/docs"
  },
  "funding": [
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/dfranco"
    }
  ],
  "config": {
    "component-dir": "vendor/components",
    "allow-plugins": {
      "composer/installers": true,
      "robloach/component-installer": true,
      "oomphinc/composer-installers-extender": true,
      "phpstan/extension-installer": true
    }
  },
  "require": {
    "php": ">=8.0",
    "ext-gettext": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-sqlite3": "*",
    "ext-posix": "*",
    "novus/nvd3": "~1.8",
    "components/font-awesome": "6.*",
    "vlucas/valitron": "^1.4",
    "vlucas/phpdotenv": "^5.5",
    "php-di/php-di": "^7.0",
    "twbs/bootstrap": "~5.2.3",
    "slim/slim": "4.*",
    "guzzlehttp/psr7": "^2",
    "odan/session": "^6.1",
    "slim/twig-view": "^3.3",
    "symfony/translation": "^5.4",
    "symfony/console": "^6.0",
    "slim/csrf": "^1.3",
    "symfony/twig-bridge": "^5.4",
    "nesbot/carbon": "^2",
    "doctrine/orm": "^2.0",
    "doctrine/dbal": "^3.0",
    "symfony/cache": "^6.0",
    "php-di/slim-bridge": "^3.4"
  },
  "require-dev": {
    "phpmd/phpmd": "@stable",
    "squizlabs/php_codesniffer": "@stable",
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^2.0",
    "symfony/var-dumper": "^5.4",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-doctrine": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "core/",
      "App\\": "application/"
    },
    "files": [
      "core/Helpers/request.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "php bwc publishAssets"
    ],
    "post-update-cmd": [
      "php bwc publishAssets"
    ],
    "post-create-project-cmd": [
      "php bwc publishAssets"
    ]
  },
  "archive": {
    "exclude": [
      ".gitignore",
      ".phpcs.xml",
      "sonar-project.properties",
      ".github",
      ".tx",
      "phpunit.xml",
      "/tests",
      ".release-please-manifest.json",
      "release-please-config.json",
      "cog.toml",
      "output.log",
      "DOCKER_ENV",
      "docker_tag",
      "website"
    ]
  }
}
