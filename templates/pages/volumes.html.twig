{% extends "layouts/default.html.twig" %}

{% block title %}{{ 'Volumes report'|trans }}{% endblock %}

{% block body %}
    <div class="container-fluid">

        {{ include('partials/_page_header.html.twig', {header: 'Volumes report'|trans, description: 'Bacula volume(s) overview'|trans }) }}

        <div class="row">
            <div class="col-10">
                <div class="table-responsive">
                    <table class="table table-condensed table-striped text-center">
                        <caption>Volume(s) list</caption>
                        <thead>
                        <tr>
                            <th class="text-center">{{ 'Volume name'|trans }}</th>
                            <th class="text-center">{{ 'Bytes'|trans }}</th>
                            <th class="text-center">{{ 'Files'|trans }}</th>
                            <th class="text-center">{{ 'Jobs'|trans }}</th>
                            <th class="text-center">{{ 'Media Type'|trans }}</th>
                            <th class="text-center">{{ 'Pool'|trans }}</th>
                            <th class="text-center">{{ 'Expire'|trans }}</th>
                            <th class="text-center">{{ 'Last written'|trans }}</th>
                            <th class="text-center">{{ 'Status'|trans }}</th>
                            <th class="text-center">{{ 'Slot'|trans }}</th>
                            <th class="text-center">{{ 'In Changer'|trans }}</th>
                        </tr>
                        </thead>

                        {% for volume in volumes %}
                            <tr>
                                <td>
                                    <a href="{{ url_for('volume_detail', {'id': volume.id }) }}"
                                       title="{{ 'Show volume'|trans }}">{{ volume.name }}</a>
                                </td>
                                <td class="text-right">{{ transform_bytes(volume.volbytes) }}</td>
                                <td class="text-right">{{ volume.volfiles|format }}</td>
                                <td class="text-right">{{ volume.voljobs|format }}</td>
                                <td>{{ volume.mediatype }}</td>
                                <td>{{ volume.pool.name }}</td>
                                <td>
                                    {% if volume.expire != 0 %}
                                        {{ volume.expirationDate }} day(s) ({{ (volume.expire|date(app_datetime_format_short)) }})
                                    {% else %}
                                        n/a
                                    {% endif %}
                                </td>
                                <td>
                                    {{ (volume.lastwritten != '0000-00-00 00:00:00' and volume.lastwritten is not null) ? volume.lastwritten|date(app_datetime_format) : 'n/a' }}
                                </td>
                                <td title="{{ volume.status }}">
                                    <i class="fa {{ volume.statusicon }}"></i>
                                </td>
                                <td>{{ (volume.inchanger) ? volume.slot : 'n/a' }}</td>
                                <td>{{ volume.inchangerstatus|raw }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="11" class="text-center">
                                    {{ 'No volume(s) to display'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                    </table>
                </div>

                {% if volumes|length > 0 %}
                    {{ include("partials/pagination.html.twig", {route: 'volumes' }) }}
                {% endif %}
            </div>

            <div class="col-2">

                <!-- Options -->
                <form class="" action="{{ url_for('volumes') }}" method="post">
                    <!-- Pools -->
                    <div class="mb-3">
                        <label class="form-label" for="filter_pool_id">{{ 'Pool'|trans }}</label>
                        <select class="form-control input-sm {{ validation_errors.filter_pool_id ? 'is-invalid' : ' ' }}" name="filter_pool_id" id="filter_pool_id">
                            <option value="0" {% if pool_id == 0 %}selected{% endif %}>Any</option>
                            {% for pool in pools_list %}
                                <option value="{{ pool.id }}" {% if pool.id == pool_id %}selected{% endif %}>{{ pool.name }}</option>
                            {% endfor %}
                        </select>
                        <div class="invalid-feedback">
                            {{ validation_errors.filter_pool_id|first }}
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="filter_orderby">{{ 'Order by'|trans }}</label>
                        <select class="form-control input-sm {{ validation_errors.filter_orderby ? 'is-invalid' : ' ' }}" name="filter_orderby" id="filter_orderby">
                            {% for key, order in orderby %}
                                <option value="{{ key }}" {% if orderby_selected == key %}selected{% endif %}>{{ order }}</option>
                            {% endfor %}
                        </select>
                        <div class="invalid-feedback">
                            {{ validation_errors.filter_orderby|first }}
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input {{ validation_errors.filter_orderby_asc ? 'is-invalid' : ' ' }}" type="checkbox" name="filter_orderby_asc"
                                   id="filter_orderby_asc" value="ASC" {{ orderby_asc_checked }}>
                            <label class="form-check-label" for="filter_orderby_asc">
                                {{ 'Asc'|trans }}
                            </label>
                            <div class="invalid-feedback">
                                {{ validation_errors.filter_orderby_asc|first }}
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input {{ validation_errors.filter_inchanger ? 'is-invalid' : ' ' }}" type="checkbox" id="filter_inchanger"
                                       name="filter_inchanger" {{ inchanger_checked }}>
                                <label class="form-check-label" for="filter_inchanger">
                                    {{ 'In changer'|trans }}
                                </label>
                                <div class="invalid-feedback">
                                    {{ validation_errors.filter_inchanger|first }}
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-primary btn-sm"
                                    title="{{ 'Apply filter and options'|trans }}">{{ 'Apply'|trans }}</button>
                        </div>
                        {{ csrf|raw }}
                </form>
            </div>
        </div>
    </div>
    <hr/>
    <!-- Found volumes footer -->
    <div class="card border-dark m-3">
        <div class="card-header">{{ 'Result'|trans }}</div>
        <div class="card-body">
            <ul class="list-group">
                <li class="list-group-item">
                    {{ 'Volume(s) found'|trans }} <span class="badge text-bg-dark">{{ volumes_count }}</span>
                </li>
                <li class="list-group-item">
                    {{ 'Total bytes'|trans }} <span class="badge text-bg-dark">{{ transform_bytes(volumes_total_bytes) }}</span>
                </li>
            </ul>
        </div>
    </div>
{% endblock %}
